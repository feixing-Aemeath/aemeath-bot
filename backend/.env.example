# This Mac's own token (every scope; the local Agents use it). Generate locally:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Other devices get their own revocable tokens: uv run python -m scripts.tokens create <name> --scope app|mcp|health_upload
ASSISTANT_TOKEN=
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8765
ASSISTANT_DATA_DIR=.state
ASSISTANT_APPLE_MODE=fake
# Agents on other devices (via Tailscale) may use /mcp when its Host is listed here,
# comma-separated, e.g. mac-mini.tail1234.ts.net. The token is still required. See docs/remote-mcp.md.
# ASSISTANT_MCP_ALLOWED_HOSTS=
# macOS: switch to real only after building and granting EventKit permissions.
# ASSISTANT_APPLE_BINARY=/absolute/path/apple-sync
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
